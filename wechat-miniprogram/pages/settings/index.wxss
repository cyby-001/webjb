.info-page {
  min-height: 100vh;
  padding: 24rpx 20rpx 40rpx;
  background: linear-gradient(180deg, #f8fbff 0%, #f3f6fb 100%);
}

.hero-card,
.info-card {
  background: rgba(255, 255, 255, 0.98);
  border-radius: 28rpx;
  border: 1rpx solid #e8edf5;
  box-shadow: 0 14rpx 34rpx rgba(15, 23, 42, 0.05);
}

.hero-card {
  padding: 26rpx 24rpx;
}

.hero-title {
  color: #0f172a;
  font-size: 36rpx;
  font-weight: 800;
}

.hero-sub {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 25rpx;
  line-height: 1.7;
}

.info-card {
  margin-top: 18rpx;
  padding: 24rpx;
}

.section-title {
  color: #1e293b;
  font-size: 28rpx;
  font-weight: 800;
}

.settings-label {
  color: #94a3b8;
  font-size: 23rpx;
  font-weight: 700;
}

.settings-label.no-margin {
  margin: 0;
}

.settings-label.gap-top {
  margin-top: 22rpx;
  margin-bottom: 12rpx;
}

.field-input {
  width: 100%;
  height: 78rpx;
  border-radius: 18rpx;
  border: 1rpx solid #dde6f0;
  background: #f8fbff;
  padding: 0 18rpx;
  color: #334155;
  font-size: 34rpx;
  display: flex;
  align-items: center;
}

.period-day-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 14rpx;
}

.period-day-label {
  color: #64748b;
  font-size: 25rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.period-day-input {
  width: 100rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: #f1f5fb;
  color: #1f2937;
  font-size: 31rpx;
  font-weight: 800;
  text-align: center;
}

.df-row {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
}

.df-item {
  flex: 1;
  height: 64rpx;
  border-radius: 16rpx;
  background: #f1f5fb;
  color: #94a3b8;
  font-size: 25rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.df-item.active {
  background: #4f7af5;
  color: #ffffff;
}

.settings-row-top {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.settings-row-top:first-child {
  margin-top: 0;
}

.settings-sub {
  margin-top: 4rpx;
  color: #94a3b8;
  font-size: 20rpx;
}

.sheet-add-btn {
  min-width: 112rpx;
  height: 48rpx;
  padding: 0 16rpx;
  border-radius: 16rpx;
  background: #eef4ff;
  color: #4f7af5;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sheet-rest-row {
  margin-top: 12rpx;
  padding: 14rpx;
  border-radius: 20rpx;
  background: #f8fbff;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.sheet-rest-name {
  flex: 1;
  min-width: 0;
  height: 60rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid #dde6f0;
  color: #64748b;
  font-size: 25rpx;
  text-align: center;
}

.sheet-rest-time-group {
  flex: 2.4;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.sheet-rest-picker {
  flex: 1;
}

.sheet-rest-time {
  width: 100%;
  height: 60rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid #dde6f0;
  color: #334155;
  font-size: 31rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sheet-rest-sep {
  width: 18rpx;
  text-align: center;
  color: #94a3b8;
  font-size: 28rpx;
  font-weight: 700;
}

.sheet-trash-btn {
  width: 40rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-shrink: 0;
}

.trash-icon {
  width: 26rpx;
  height: 28rpx;
  position: relative;
}

.trash-lid {
  position: absolute;
  top: 1rpx;
  left: 5rpx;
  width: 16rpx;
  height: 4rpx;
  background: #fb7185;
  border-radius: 4rpx;
}

.trash-box {
  position: absolute;
  left: 4rpx;
  right: 4rpx;
  top: 7rpx;
  bottom: 1rpx;
  border: 3rpx solid #fb7185;
  border-top-width: 4rpx;
  border-radius: 4rpx 4rpx 6rpx 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.trash-line {
  width: 2rpx;
  height: 10rpx;
  background: #fb7185;
  border-radius: 2rpx;
}

.settings-save {
  margin-top: 26rpx;
}
