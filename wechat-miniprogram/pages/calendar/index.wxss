/* ====== header / top menu (inlined from app-header) ====== */
.hero {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  padding-left: 20rpx;
  padding-right: 20rpx;
  background: rgba(255, 255, 255, 0.94);
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.9);
  box-shadow: 0 8rpx 22rpx rgba(15, 23, 42, 0.04);
}

.hero-spacer {
  width: 100%;
}

.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.brand-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #3b82f6, #4f46e5);
  box-shadow: 0 10rpx 18rpx rgba(79, 70, 229, 0.24);
  position: relative;
  flex-shrink: 0;
}

.brand-body {
  position: absolute;
  left: 14rpx;
  right: 14rpx;
  bottom: 14rpx;
  height: 20rpx;
  border: 3rpx solid #ffffff;
  border-radius: 6rpx;
}

.brand-handle {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  top: 11rpx;
  height: 10rpx;
  border: 3rpx solid #ffffff;
  border-bottom: 0;
  border-radius: 8rpx 8rpx 0 0;
}

.brand-copy {
  min-width: 0;
}

.brand-title {
  color: #0f172a;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1.15;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.brand-sub {
  margin-top: 2rpx;
  color: #94a3b8;
  font-size: 20rpx;
  font-weight: 600;
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 0;
  flex-shrink: 0;
  margin-right: -30rpx;
}

.icon-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid #e6ecf5;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #64748b;
  box-shadow: 0 6rpx 14rpx rgba(15, 23, 42, 0.04);
}

.menu-btn.solo {
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  background: linear-gradient(180deg, #ffffff, #f8fbff);
}

.menu-entry-image {
  width: 30rpx;
  height: 30rpx;
  display: block;
  opacity: 0.92;
}

.menu-mask {
  position: fixed;
  inset: 0;
  z-index: 120;
}

.menu-card {
  position: absolute;
  right: 20rpx;
  width: 296rpx;
  padding: 10rpx 0 12rpx;
  background: rgba(255, 255, 255, 0.98);
  border-radius: 24rpx;
  border: 1rpx solid #ebf0f7;
  box-shadow: 0 24rpx 44rpx rgba(15, 23, 42, 0.18);
  overflow: hidden;
}

.menu-group-title {
  padding: 10rpx 22rpx 8rpx;
  color: #94a3b8;
  font-size: 20rpx;
  font-weight: 700;
}

.menu-divider {
  height: 1rpx;
  margin: 10rpx 18rpx;
  background: #edf2f7;
}

.menu-item {
  padding: 18rpx 22rpx;
  color: #334155;
  font-size: 26rpx;
  font-weight: 600;
}

.menu-item.strong {
  color: #059669;
}

.menu-item.danger {
  color: #ef4444;
}

/* ====== calendar ====== */
.calendar-page {
  padding-top: 0;
}

.calendar-card {
  margin-top: 18rpx;
  overflow: hidden;
}

.calendar-head {
  height: 92rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #eff3f8;
}

.month-btn {
  width: 54rpx;
  height: 54rpx;
  border-radius: 14rpx;
  background: #f7faff;
  border: 1rpx solid #e7eef7;
  display: flex;
  align-items: center;
  justify-content: center;
}

.month-arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 4rpx solid #64748b;
  border-right: 4rpx solid #64748b;
}

.month-arrow.left {
  transform: rotate(-135deg);
  margin-left: 8rpx;
}

.month-arrow.right {
  transform: rotate(45deg);
  margin-right: 8rpx;
}

.month-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1e293b;
}

.week-row {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  padding: 12rpx 10rpx 10rpx;
}

.week-item {
  text-align: center;
  color: #9aa8bc;
  font-size: 22rpx;
  font-weight: 700;
}

.days-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 1rpx;
  background: #edf2f7;
  border-top: 1rpx solid #edf2f7;
  border-bottom: 1rpx solid #edf2f7;
}

.day-cell {
  min-height: 126rpx;
  background: #ffffff;
  position: relative;
  padding: 10rpx 8rpx 8rpx;
}

.day-cell.empty {
  background: #f8fbff;
}

.day-cell.today {
  background: #f3f8ff;
}

.day-cell.selected {
  outline: 2rpx solid #c5d5f0;
  outline-offset: -2rpx;
  background: #fafcfe;
  z-index: 1;
}

.day-number {
  color: #334155;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1;
}

.day-number.weekend {
  color: #f97316;
}

.day-lunar {
  margin-top: 6rpx;
  color: #b0bdd0;
  font-size: 18rpx;
  line-height: 1;
}

.day-badge {
  margin-top: 10rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 8rpx;
  color: #ffffff;
  font-size: 17rpx;
  font-weight: 800;
  white-space: nowrap;
  box-shadow: 0 6rpx 12rpx rgba(79, 122, 245, 0.18);
}

.day-badge.weekday { background: var(--c-weekday, #4f7af5); }
.day-badge.weekend { background: var(--c-weekend, #ff8b35); }
.day-badge.holiday { background: var(--c-holiday, #ef4444); }
.day-badge.leave { background: var(--c-leave, #b38cff); }

.day-note {
  margin-top: 6rpx;
  max-width: 100%;
  color: #a1aec1;
  font-size: 18rpx;
  line-height: 1.1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.today-dot {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #3b82f6;
}

.calendar-foot {
  padding: 16rpx 18rpx;
  text-align: center;
  color: #a3b0c4;
  font-size: 21rpx;
}

.selected-detail-card {
  margin-top: 16rpx;
  padding: 20rpx;
}

.selected-detail-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.selected-detail-caption {
  color: #94a3b8;
  font-size: 22rpx;
  font-weight: 700;
}

.selected-detail-title {
  margin-top: 4rpx;
  color: #1f2937;
  font-size: 32rpx;
  font-weight: 800;
}

.selected-detail-badge {
  height: 44rpx;
  padding: 0 14rpx;
  border-radius: 14rpx;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
}

.selected-detail-badge.ot {
  background: #4f7af5;
}

.selected-detail-badge.leave {
  background: #b38cff;
}

.selected-note {
  margin-top: 16rpx;
  color: #475569;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-all;
}

.selected-empty {
  margin-top: 16rpx;
  color: #a1aec1;
  font-size: 25rpx;
}

.day-record-item {
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  background: #f8fbff;
}

.day-record-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.day-record-time {
  flex: 1;
  min-width: 0;
  color: #64748b;
  font-size: 24rpx;
  font-weight: 700;
}

.day-record-dur {
  color: #334155;
  font-size: 26rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.day-record-note {
  margin-top: 8rpx;
  color: #475569;
  font-size: 24rpx;
  line-height: 1.5;
}

.selected-image-row {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.selected-image {
  width: 132rpx;
  height: 132rpx;
  border-radius: 16rpx;
  background: #eef4ff;
  display: block;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  min-height: 132rpx;
  padding: 10rpx 34rpx calc(28rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.97);
  backdrop-filter: blur(16px);
  border-top: 1rpx solid rgba(226, 232, 240, 0.9);
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  z-index: 90;
}

.tab-btn {
  width: 160rpx;
  color: #b0bccf;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 4rpx;
}

.tab-btn.active { color: #3563eb; }

.tab-icon {
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.calendar-icon {
  width: 24rpx;
  height: 24rpx;
  border: 2rpx solid currentColor;
  border-radius: 6rpx;
  position: relative;
}

.calendar-icon::before {
  content: '';
  position: absolute;
  left: 3rpx;
  right: 3rpx;
  top: 7rpx;
  height: 2rpx;
  background: currentColor;
}

.calendar-icon::after {
  content: '';
  position: absolute;
  left: 6rpx;
  top: 3rpx;
  width: 2rpx;
  height: 4rpx;
  background: currentColor;
  box-shadow: 8rpx 0 0 currentColor;
}

.stats-icon {
  width: 28rpx;
  height: 24rpx;
  gap: 4rpx;
}

.stats-col {
  width: 5rpx;
  background: currentColor;
  border-radius: 4rpx 4rpx 0 0;
}

.stats-a { height: 12rpx; }
.stats-b { height: 20rpx; }
.stats-c { height: 16rpx; }

.tab-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.add-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: -42rpx;
}

.add-btn {
  width: 98rpx;
  height: 98rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #3b82f6, #4f46e5);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 58rpx;
  line-height: 1;
  box-shadow: 0 20rpx 34rpx rgba(79, 70, 229, 0.28);
}

.add-label {
  margin-top: 6rpx;
  color: #b0bccf;
  font-size: 20rpx;
  font-weight: 700;
}

.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.48);
  display: flex;
  align-items: flex-end;
  z-index: 130;
}

.sheet-panel {
  width: 100%;
  background: #ffffff;
  border-radius: 30rpx 30rpx 0 0;
  overflow: hidden;
  max-height: 90vh;
}

.sheet-grabber {
  width: 88rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #d6deea;
  margin: 12rpx auto 10rpx;
}

.sheet-top {
  padding: 18rpx 22rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #ffffff;
}

.sheet-top.ot { background: linear-gradient(135deg, #3b82f6, #4f46e5); }
.sheet-top.leave { background: linear-gradient(135deg, #a855f7, #ec4899); }

.sheet-caption {
  font-size: 21rpx;
  opacity: 0.88;
}

.sheet-title {
  margin-top: 4rpx;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.15;
}

.sheet-close {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.sheet-body {
  padding: 18rpx 20rpx 24rpx;
}

.segment {
  display: flex;
  gap: 12rpx;
  padding: 8rpx;
  border-radius: 18rpx;
  background: #edf2f9;
}

.segment-item {
  flex: 1;
  height: 66rpx;
  border-radius: 14rpx;
  color: #64748b;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.segment-item.active {
  background: #ffffff;
  color: #3563eb;
  box-shadow: 0 8rpx 18rpx rgba(59, 130, 246, 0.08);
}

.field-block {
  margin-top: 16rpx;
}

.field-label {
  margin-bottom: 8rpx;
  color: #9aa8bc;
  font-size: 22rpx;
  font-weight: 700;
}

.field-label.no-margin {
  margin-bottom: 0;
}

.field-input {
  width: 100%;
  height: 78rpx;
  border-radius: 18rpx;
  border: 1rpx solid #dde6f0;
  background: #f8fbff;
  padding: 0 18rpx;
  color: #334155;
  font-size: 34rpx;
  display: flex;
  align-items: center;
}

.duration-row {
  display: flex;
  gap: 12rpx;
}

.flex-fill { flex: 1; }

.duration-chip {
  min-width: 110rpx;
  height: 78rpx;
  padding: 0 12rpx;
  border-radius: 18rpx;
  background: #eef4ff;
  color: #3563eb;
  font-size: 26rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
}

.note-area {
  width: 100%;
  min-height: 120rpx;
  border-radius: 18rpx;
  border: 1rpx solid #dde6f0;
  background: #f8fbff;
  padding: 18rpx;
  color: #334155;
  font-size: 30rpx;
}

.image-head {
  margin-bottom: 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.image-count {
  color: #94a3b8;
  font-size: 22rpx;
  font-weight: 700;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.image-item,
.image-add {
  width: 150rpx;
  height: 150rpx;
  border-radius: 18rpx;
  overflow: hidden;
  position: relative;
  flex-shrink: 0;
}

.record-image {
  width: 100%;
  height: 100%;
  display: block;
  background: #eef4ff;
}

.image-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(15, 23, 42, 0.72);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-add {
  border: 2rpx dashed #c9d7ec;
  background: #f8fbff;
  color: #64748b;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.image-add-plus {
  font-size: 48rpx;
  line-height: 1;
  font-weight: 600;
}

.image-add-text {
  margin-top: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.sheet-actions {
  margin-top: 20rpx;
  display: flex;
  gap: 12rpx;
}

.delete-btn { width: 200rpx; }
.save-btn { flex: 1; }
.leave-save { background: linear-gradient(135deg, #a855f7, #ec4899); }

/* ---- voice ---- */
.voice-add-btn {
  width: 150rpx;
  height: 150rpx;
  border-radius: 18rpx;
  border: 2rpx dashed #c9d7ec;
  background: #f8fbff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.voice-add-btn.recording {
  border-color: #ef4444;
  background: #fef2f2;
  animation: voice-pulse 0.8s ease-in-out infinite;
}

.voice-add-icon-img {
  width: 40rpx;
  height: 40rpx;
  display: block;
}

.voice-add-text {
  color: #64748b;
  font-size: 22rpx;
  font-weight: 700;
}

.voice-recording-text {
  color: #ef4444;
  font-size: 20rpx;
  font-weight: 700;
}

.voice-bubble {
  width: 150rpx;
  height: 150rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #eef4ff, #e8f0fe);
  border: 1rpx solid #d0ddf5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  position: relative;
  flex-shrink: 0;
}

.voice-bubble-dur {
  color: #4f7af5;
  font-size: 24rpx;
  font-weight: 800;
}

.voice-waves {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 6rpx;
  height: 24rpx;
}

.wave-bar {
  width: 5rpx;
  border-radius: 4rpx;
  background: #4f7af5;
}

.wave-bar:nth-child(1) { height: 10rpx; }
.wave-bar:nth-child(2) { height: 18rpx; }
.wave-bar:nth-child(3) { height: 12rpx; }

.voice-waves.playing .wave-bar:nth-child(1) {
  animation: wave-jump 0.6s ease-in-out infinite;
}
.voice-waves.playing .wave-bar:nth-child(2) {
  animation: wave-jump 0.6s ease-in-out 0.15s infinite;
}
.voice-waves.playing .wave-bar:nth-child(3) {
  animation: wave-jump 0.6s ease-in-out 0.3s infinite;
}

@keyframes wave-jump {
  0%, 100% { transform: scaleY(1); }
  50% { transform: scaleY(0.35); }
}

@keyframes voice-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.6; }
}

.voice-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(15, 23, 42, 0.72);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* voice in selected-day card */
.voice-bubble-sm {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  width: 132rpx;
  height: 132rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #eef4ff, #e8f0fe);
  border: 1rpx solid #d0ddf5;
  flex-shrink: 0;
}

.voice-bubble-sm .voice-bubble-dur {
  color: #4f7af5;
  font-size: 24rpx;
  font-weight: 800;
}

.voice-bubble-sm .voice-waves {
  height: 20rpx;
  gap: 5rpx;
}

.voice-bubble-sm .wave-bar {
  width: 4rpx;
}

.voice-bubble-sm .wave-bar:nth-child(1) { height: 8rpx; }
.voice-bubble-sm .wave-bar:nth-child(2) { height: 15rpx; }
.voice-bubble-sm .wave-bar:nth-child(3) { height: 10rpx; }
.stats-page {
  padding-top: 0;
}

.month-switch {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin: 18rpx 4rpx 16rpx;
}

.month-caption {
  flex: 1;
  text-align: center;
  color: #9aa8bc;
  font-size: 28rpx;
  font-weight: 700;
}

.month-nav-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid #e8edf5;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.04);
}

.month-nav-arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 4rpx solid #6b7a90;
  border-right: 4rpx solid #6b7a90;
}

.month-nav-arrow.left {
  transform: rotate(-135deg);
  margin-left: 6rpx;
}

.month-nav-arrow.right {
  transform: rotate(45deg);
  margin-right: 6rpx;
}

.summary-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.summary-card {
  background: rgba(255, 255, 255, 0.98);
  border-radius: 26rpx;
  box-shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.05);
}

.summary-card.strong {
  flex: 1;
  padding: 18rpx 18rpx 16rpx;
}

.summary-card.strong.blue { border: 2rpx solid #4f7af5; }
.summary-card.strong.purple { border: 2rpx solid #da67d4; }

.summary-head {
  color: #4f6da0;
  font-size: 24rpx;
