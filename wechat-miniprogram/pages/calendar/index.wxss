.panel {
  margin-bottom: 16rpx;
  padding: 20rpx;
}

.panel-top { margin-bottom: 14rpx; }

.panel-title {
  color: #1f2937;
  font-size: 34rpx;
  font-weight: 800;
}

.donut-panel {
  padding: 24rpx 22rpx;
  border: 1rpx solid #e8edf5;
}

.donut-panel-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.donut-caption {
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  background: #f1f5fb;
  color: #7c8ca3;
  font-size: 20rpx;
  font-weight: 700;
}

.donut-layout {
  display: flex;
  position: relative;
  align-items: center;
  justify-content: center;
  min-height: 270rpx;
  padding: 12rpx 0 2rpx;
  gap: 18rpx;
}

.donut-wrap {
  flex: 0 0 250rpx;
  display: flex;
  justify-content: center;
  padding: 0;
}

.donut-stage {
  width: 238rpx;
  height: 238rpx;
  position: relative;
}

.donut-canvas {
  width: 238rpx;
  height: 238rpx;
}

.donut-legend {
  margin-top: 8rpx;
  gap: 20rpx;
  font-size: 22rpx;
}

.donut-center {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.donut-center-label {
  color: #94a3b8;
  font-size: 20rpx;
  font-weight: 700;
}

.donut-center-value {
  margin-top: 5rpx;
  color: #1f2937;
  font-size: 36rpx;
  font-weight: 850;
  line-height: 1;
}

.donut-center-sub {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #64748b;
  font-size: 22rpx;
  font-weight: 700;
}

.donut-center-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}


.legend-row {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 24rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 18rpx;
  border-radius: 14rpx;
  transition: background 0.15s;
}

.legend-item.active {
  background: #eef4ff;
  color: #3563eb;
  font-weight: 700;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  display: inline-block;
}

.dot.blue { background: var(--c-weekday, #4f7af5); }
.dot.orange { background: var(--c-weekend, #ff7a1a); }
.dot.purple { background: var(--c-leave, #b38cff); }
.dot.red { background: var(--c-holiday, #ef4444); }

.range-row {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.range-pill,
.filter-pill {
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 16rpx;
  background: #f1f5fb;
  color: #94a3b8;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.range-pill.active,
.filter-pill.active {
  background: #4f7af5;
  color: #ffffff;
}

.trend-note {
  margin-bottom: 10rpx;
  color: #4f7af5;
  font-size: 22rpx;
  font-weight: 700;
}

.chart-hint {
  margin-bottom: 10rpx;
  height: 44rpx;
  padding: 0 14rpx;
  border-radius: 16rpx;
  background: transparent;
  color: #4f6da0;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  transition: background 0.15s;
}

.chart-hint.active {
  background: #f7faff;
}

.bar-area {
  height: 214rpx;
  padding: 8rpx 8rpx 0;
