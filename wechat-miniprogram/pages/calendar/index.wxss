  justify-content: space-between;
}

.bar-col {
  width: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.15s ease-out;
}

.bar-col.active {
  transform: scale(1.18);
}

.bar-col.active .bar.ot {
  box-shadow: 0 6rpx 16rpx rgba(79, 122, 245, 0.5);
}

.bar-col.active .bar.leave {
  box-shadow: 0 6rpx 16rpx rgba(179, 140, 255, 0.5);
}

.bar-col.active .bar-label {
  color: #1f2937;
  font-weight: 800;
}

