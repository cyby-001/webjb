  border-radius: 10rpx 10rpx 0 0;
}

.bar.ot { background: var(--c-weekday, #4f7af5); }
.bar.leave { background: var(--c-leave, #b38cff); }

.bar-label {
  margin-top: 8rpx;
  color: #9aa8bc;
  font-size: 20rpx;
}

.trend-legend { margin-top: 12rpx; }

