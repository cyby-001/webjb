<wxs module="fmt" src="../../utils/fmt.wxs"></wxs>

<view class="container {{currentTab === 'calendar' ? 'calendar-page' : 'stats-page'}}" style="--c-weekday: {{theme.weekday}}; --c-weekend: {{theme.weekend}}; --c-holiday: {{theme.holiday}}; --c-leave: {{theme.leave}};">
  <view class="hero" style="padding-top: {{navTop}}px;">
    <view class="nav" style="height: {{navHeight}}px; padding-right: {{capsuleSpace}}px;">
      <view class="brand">
        <view class="brand-icon">
          <view class="brand-handle"></view>
          <view class="brand-body"></view>
        </view>
        <view class="brand-copy">
          <view class="brand-title">加班记录助手</view>
          <view class="brand-sub">专业工时管理</view>
        </view>
      </view>
      <view class="nav-actions">
        <view class="icon-btn menu-btn solo" bindtap="toggleTopMenu">
          <image class="menu-entry-image" src="../../setting.png" mode="aspectFit" />
        </view>
      </view>
    </view>
  </view>
  <view class="hero-spacer" style="height: {{heroHeight}}px;"></view>

  <view wx:if="{{showTopMenu}}" class="menu-mask" bindtap="closeTopMenu">
    <view class="menu-card" catchtap="noop" style="top: {{menuTop}}px;">
      <view class="menu-group-title">设置与帮助</view>
      <view class="menu-item" bindtap="goSettingsPage">工时设置</view>
      <view class="menu-item" bindtap="goPrivacyPage">隐私说明</view>
      <view class="menu-item" bindtap="goAboutPage">关于</view>
      <view class="menu-item" bindtap="goFeedbackPage">意见反馈</view>
      <view class="menu-divider"></view>
      <view class="menu-group-title">数据管理</view>
      <view class="menu-item" bindtap="importJSON">导入备份</view>
      <view class="menu-item" bindtap="backupJSON">导出 JSON</view>
      <view class="menu-item strong" bindtap="exportTable">导出表格</view>
      <view class="menu-item danger" bindtap="clearAllRecords">清除全部记录</view>
    </view>
  </view>

  <!-- ====== 日历视图 ====== -->
  <block wx:if="{{currentTab === 'calendar'}}">
  <view class="card calendar-card">
    <view class="calendar-head">
      <view class="month-btn" bindtap="prevMonth"><view class="month-arrow left"></view></view>
      <view class="month-title">{{monthTitle}}</view>
      <view class="month-btn" bindtap="nextMonth"><view class="month-arrow right"></view></view>
    </view>
    <view class="week-row">
      <text wx:for="{{weekShort}}" wx:key="*this" class="week-item">{{item}}</text>
    </view>
    <view class="days-grid">
      <block wx:for="{{monthDays}}" wx:key="key">
        <view wx:if="{{!item.empty}}" class="day-cell {{item.isToday ? 'today' : ''}} {{item.selected ? 'selected' : ''}}" data-date="{{item.dateStr}}" bindtap="onTapDay">
          <view class="day-number {{item.isWeekend ? 'weekend' : ''}}">{{item.day}}</view>
          <view class="day-lunar">{{item.lunarText}}</view>
          <view wx:if="{{item.dayRecords.length}}" class="day-badge {{item.tagClass}}">{{fmt.fmtDur(item.dayTotal, settingDurationFormat)}}</view>
          <view wx:if="{{item.notePreview}}" class="day-note">{{item.notePreview}}</view>
          <view wx:if="{{item.isToday && !item.dayRecords.length}}" class="today-dot"></view>
        </view>
        <view wx:else class="day-cell empty"></view>
      </block>
    </view>
    <view class="calendar-foot">{{lunarInfo}}</view>
  </view>

  <view class="card selected-detail-card">
    <view class="selected-detail-head">
      <view>
        <view class="selected-detail-caption">每日记录</view>
        <view class="selected-detail-title">{{selectedDateText}}</view>
      </view>
    </view>
    <block wx:if="{{selectedDayRecords.length}}">
      <view class="day-record-item" wx:for="{{selectedDayRecords}}" wx:key="id" data-id="{{item.id}}" bindtap="editSelectedRecord">
        <view class="day-record-top">
          <view class="type-badge {{item.badgeClass}}">{{item.category === '请假' ? '请假' : '加班'}}</view>
          <view class="day-record-time">{{item.startTime}}-{{item.endTime}}</view>
          <view class="day-record-dur">{{fmt.fmtDur(item.duration, settingDurationFormat)}}</view>
        </view>
        <view wx:if="{{item.note}}" class="day-record-note">{{item.note}}</view>
        <view wx:if="{{(item.images && item.images.length) || item.voiceDuration}}" class="selected-image-row">
          <image wx:for="{{item._resolvedUrls}}" wx:key="*this" wx:for-item="url" class="selected-image" src="{{url}}" mode="aspectFill" data-id="{{item.id}}" data-index="{{index}}" catchtap="previewSelectedDayImage" />
          <view wx:if="{{item.voiceDuration}}" class="voice-bubble-sm" data-id="{{item.id}}" catchtap="toggleCardVoicePlay">
            <view class="voice-bubble-dur">{{item.voiceDuration}}"</view>
            <view class="voice-waves {{cardVoicePlayingId === item.id ? 'playing' : ''}}">
              <view class="wave-bar"></view>
              <view class="wave-bar"></view>
              <view class="wave-bar"></view>
            </view>
          </view>
        </view>
      </view>
    </block>
    <view wx:else class="selected-empty">当天暂无记录</view>
  </view>
  </block>

  <!-- ====== 统计视图 ====== -->
  <block wx:if="{{currentTab === 'stats'}}">
  <view class="month-switch">
    <view class="month-nav-btn" bindtap="prevStatsMonth"><view class="month-nav-arrow left"></view></view>
    <view class="month-caption">{{monthLabel}}</view>
    <view class="month-nav-btn" bindtap="nextStatsMonth"><view class="month-nav-arrow right"></view></view>
  </view>

  <view class="summary-row">
    <view class="summary-card strong blue">
      <view class="summary-head">本月加班总时长</view>
      <view class="summary-value">{{fmt.fmtNum(monthSummary.otHours, settingDurationFormat)}}<text wx:if="{{settingDurationFormat === 'hour'}}" class="val-unit">h</text></view>
      <view class="summary-foot">时长 / {{monthSummary.otCount}} 次</view>
    </view>
    <view class="summary-card strong purple">
      <view class="summary-head">本月请假 / 调休</view>
      <view class="summary-value">{{fmt.fmtNum(monthSummary.leaveHours, settingDurationFormat)}}<text wx:if="{{settingDurationFormat === 'hour'}}" class="val-unit">h</text></view>
      <view class="summary-foot">时长 / {{monthSummary.leaveCount}} 次</view>
    </view>
  </view>

  <view class="summary-card total-card">
    <view class="total-overview">
      <view class="total-stat">
        <view class="total-head">累计加班</view>
        <view class="total-value">{{fmt.fmtNum(allTimeSummary.totalOtHours, settingDurationFormat)}}<text wx:if="{{settingDurationFormat === 'hour'}}" class="val-unit">h</text></view>
        <view class="total-foot">共 {{allTimeSummary.totalOtCount}} 次记录</view>
      </view>
      <view class="total-divider"></view>
      <view class="total-stat leave">
        <view class="total-head">累计请假</view>
        <view class="total-value">{{fmt.fmtNum(allTimeSummary.totalLeaveHours, settingDurationFormat)}}<text wx:if="{{settingDurationFormat === 'hour'}}" class="val-unit">h</text></view>
        <view class="total-foot">共 {{allTimeSummary.totalLeaveCount}} 次记录</view>
      </view>
    </view>
    <view class="total-meta-row">
      <view class="total-meta-item">
        <view class="total-meta-label">今年累计加班</view>
        <view class="total-meta-value">{{fmt.fmtNum(yearSummary.yearOtHours, settingDurationFormat)}}<text wx:if="{{settingDurationFormat === 'hour'}}" class="val-unit">h</text></view>
        <view class="total-meta-note">{{yearSummary.yearOtDays}} 天 / {{currentYearLabel}}年</view>
      </view>
      <view class="total-meta-item">
        <view class="total-meta-label">月均加班</view>
        <view class="total-meta-value">{{fmt.fmtNum(avgMonthlyOt, settingDurationFormat)}}<text wx:if="{{settingDurationFormat === 'hour'}}" class="val-unit">h</text></view>
        <view class="total-meta-note">按当前范围计算</view>
      </view>
    </view>
  </view>

  <view class="card panel donut-panel">
  <view class="donut-panel-top">
    <view class="panel-title">本月加班类型占比</view>
    <view class="donut-caption">点击查看详情</view>
  </view>
  <view class="donut-layout">
    <view class="donut-wrap">
      <view class="donut-stage">
        <canvas type="2d" id="overtimeDonut" class="donut-canvas" bindtouchstart="selectDonutSegment"></canvas>
        <view class="donut-center">
          <view class="donut-center-label">{{donutSelectedIndex === -1 ? '总计' : donutSelectedLabel}}</view>
          <view class="donut-center-value">{{fmt.fmtNum(donutSelectedIndex === -1 ? donut.total : donutSelectedHours, settingDurationFormat)}}<text wx:if="{{settingDurationFormat === 'hour'}}" class="val-unit">h</text></view>
          <view wx:if="{{donutSelectedIndex !== -1}}" class="donut-center-sub">
            <view class="donut-center-dot" style="background:{{donutSelectedColor}};"></view>
            <text>{{donutSelectedPercent}}%</text>
          </view>
        </view>
      </view>
    </view>
  </view>
  <view class="legend-row donut-legend">
    <view class="legend-item {{donutSelectedIndex === 0 ? 'active' : ''}}" data-index="0" bindtap="onLegendTap"><text class="dot blue"></text><text>平日</text></view>
    <view class="legend-item {{donutSelectedIndex === 1 ? 'active' : ''}}" data-index="1" bindtap="onLegendTap"><text class="dot orange"></text><text>周末</text></view>
    <view class="legend-item {{donutSelectedIndex === 2 ? 'active' : ''}}" data-index="2" bindtap="onLegendTap"><text class="dot red"></text><text>节假日</text></view>
  </view>
</view>

  <view class="card panel">
    <view class="panel-top">
      <view class="panel-title">加班趋势</view>
      <view class="range-row">
        <view wx:for="{{rangeOptions}}" wx:key="key" class="range-pill {{activeRange === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="setRange">{{item.label}}</view>
      </view>
    </view>
    <view wx:if="{{trendMaxText}}" class="trend-note">加班峰值：{{trendMaxText}}</view>
    <view class="chart-hint {{chartHint ? 'active' : ''}}">{{chartHint}}</view>
    <view class="bar-area">
      <view class="bar-col {{trendCursor === index ? 'active' : ''}}" wx:for="{{trendBars}}" wx:key="month" data-index="{{index}}" data-label="{{item.shortLabel}}" data-ot="{{item.otHours}}" data-leave="{{item.leaveHours}}" bindtap="onTrendTap">
        <view class="bars">
          <view wx:if="{{item.otHeight > 0}}" class="bar ot" style="height: {{item.otHeight}}rpx"></view>
          <view wx:if="{{item.leaveHeight > 0}}" class="bar leave" style="height: {{item.leaveHeight}}rpx"></view>
        </view>
        <view class="bar-label">{{item.shortLabel}}月</view>
      </view>
    </view>
    <view class="legend-row trend-legend">
      <view class="legend-item"><text class="dot blue"></text><text>加班</text></view>
      <view class="legend-item"><text class="dot purple"></text><text>请假</text></view>
    </view>
  </view>

  <view class="card panel">
    <view class="panel-top detail-top">
      <view class="panel-title">记录明细 <text class="detail-sub">（按所选时间范围）</text></view>
      <view class="detail-filters">
        <view class="filter-pill {{detailFilter === 'all' ? 'active' : ''}}" data-filter="all" bindtap="setDetailFilter">全部</view>
        <view class="filter-pill {{detailFilter === 'ot' ? 'active' : ''}}" data-filter="ot" bindtap="setDetailFilter">加班</view>
        <view class="filter-pill {{detailFilter === 'leave' ? 'active' : ''}}" data-filter="leave" bindtap="setDetailFilter">请假</view>
      </view>
    </view>
    <scroll-view wx:if="{{detailRecords.length}}" class="detail-scroll" scroll-y="true" enhanced="true" show-scrollbar="false">
      <view class="detail-list">
        <view class="detail-item" wx:for="{{detailRecords}}" wx:key="id">
          <view class="detail-date">{{item.shortDate}}</view>
          <view class="detail-main">
            <view class="detail-line">
              <view class="type-badge {{item.badgeClass}}">{{item.badgeText}}</view>
              <view class="detail-hours">{{fmt.fmtDur(item.duration, settingDurationFormat)}}</view>
              <view wx:if="{{item.note}}" class="detail-note">{{item.note}}</view>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
    <view wx:else class="empty-text">当前范围内暂无记录</view>
  </view>

  <view class="card calc-shell">
    <view class="calc-head">
      <view class="panel-title">{{calcMode === 'money' ? '加班费估算' : '调休时长'}}</view>
      <view class="calc-head-right">
        <view class="calc-rule-btn" bindtap="openPayRuleSheet">{{payRuleName}} ▾</view>
        <view class="calc-mode-switch">
          <view class="calc-mode-item {{calcMode === 'money' ? 'active' : ''}}" data-mode="money" bindtap="switchCalcMode">报酬</view>
          <view class="calc-mode-item {{calcMode === 'leave' ? 'active' : ''}}" data-mode="leave" bindtap="switchCalcMode">调休</view>
        </view>
      </view>
    </view>
    <view class="calc-body">
      <view class="calc-tip">根据时间范围和加班类型自动估算，输入变化实时更新，结果请以实际工资规则为准。</view>
      <view class="form-row">
        <view class="f-label">开始日期</view>
        <picker mode="date" value="{{calcStart}}" data-field="calcStart" bindchange="onCalcDateChange">
          <view class="f-input">{{calcStart}}</view>
        </picker>
      </view>
      <view class="form-row">
        <view class="f-label">结束日期</view>
        <picker mode="date" value="{{calcEnd}}" data-field="calcEnd" bindchange="onCalcDateChange">
          <view class="f-input">{{calcEnd}}</view>
        </picker>
      </view>
      <view wx:if="{{calcMode === 'money' && payRule.mode !== 'tier'}}" class="form-row">
        <view class="f-label">时薪</view>
        <input class="f-input" type="digit" value="{{hourlyRate}}" bindinput="onRateInput" />
      </view>
      <view class="result-panel">
        <view class="result-main">
          <view wx:if="{{calcMode === 'money'}}" class="result-big">￥{{calcResult.amount}}</view>
          <view wx:else class="result-big">{{fmt.fmtDur(calcResult.settlementHours, settingDurationFormat)}}</view>
          <view class="result-sub">{{calcMode === 'money' ? (payRule.mode === 'tier' && calcResult.tierText ? '本月档位 ' + calcResult.tierText : '预计金额') : '可调休时长'}}{{calcMode === 'leave' ? '（' + settlementDays + '天' + settlementRemainHours + '小时）' : ''}}</view>
        </view>
        <view class="result-divider"></view>
        <view class="result-grid">
          <view class="result-cell">
            <view class="r-num">{{calcResult.weekday}}</view>
            <view class="r-label">平日{{calcMode === 'money' && payRule.mode !== 'tier' ? ' x' + payRule.weekday : ''}}</view>
          </view>
          <view class="result-cell">
            <view class="r-num">{{calcResult.weekend}}</view>
            <view class="r-label">周末{{calcMode === 'money' && payRule.mode !== 'tier' ? ' x' + payRule.weekend : ''}}</view>
          </view>
          <view class="result-cell">
            <view class="r-num">{{calcResult.holiday}}</view>
            <view class="r-label">节假日{{calcMode === 'money' && payRule.mode !== 'tier' ? ' x' + payRule.holiday : ''}}</view>
          </view>
          <view wx:if="{{calcMode === 'money' && payRule.mode !== 'tier'}}" class="result-cell">
            <view class="r-num accent">{{calcResult.weighted}}</view>
            <view class="r-label">折算工时</view>
          </view>
          <view class="result-cell">
            <view class="r-num leave-num">{{calcResult.leave}}</view>
            <view class="r-label">请假</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="card panel achievements-panel">
    <view class="panel-title">我的成就</view>
    <view wx:if="{{!unlockedAchievements.length}}" class="ach-empty">还没有解锁成就，继续记录下去吧</view>
    <view wx:else class="ach-grid">
      <view wx:for="{{unlockedAchievements}}" wx:key="id" class="ach-item" data-id="{{item.id}}" bindtap="showAchievementDetail">
        <view class="ach-emoji">{{item.emoji}}</view>
        <view class="ach-name">{{item.name}}</view>
        <view class="ach-time">{{item.time}}</view>
      </view>
    </view>
  </view>
  </block>

  <!-- ====== 底部导航栏（共享） ====== -->
  <view class="bottom-bar">
    <view class="tab-btn {{currentTab === 'calendar' ? 'active' : ''}}" bindtap="switchTab" data-tab="calendar">
      <view class="tab-icon calendar-icon"></view>
      <view class="tab-label">日历</view>
    </view>
    <view class="add-wrap" bindtap="quickAdd">
      <view class="add-btn">+</view>
      <view class="add-label">记录</view>
    </view>
    <view class="tab-btn {{currentTab === 'stats' ? 'active' : ''}}" bindtap="switchTab" data-tab="stats">
      <view class="tab-icon stats-icon">
        <view class="stats-col stats-a"></view>
        <view class="stats-col stats-b"></view>
        <view class="stats-col stats-c"></view>
      </view>
      <view class="tab-label">统计</view>
    </view>
  </view>

  <!-- ====== 编辑面板（日历） ====== -->
  <view wx:if="{{showEditor}}" class="sheet-mask" bindtap="closeEditor">
    <view class="sheet-panel" catchtap="noop">
      <view class="sheet-grabber"></view>
      <view class="sheet-top {{form.category === '请假' ? 'leave' : 'ot'}}">
        <view>
          <view class="sheet-caption">记录详情</view>
          <view class="sheet-title">{{selectedDateText}}</view>
        </view>
        <view class="sheet-close" bindtap="closeEditor">x</view>
      </view>
      <view class="sheet-body">
        <view class="segment">
          <view class="segment-item {{form.category === '加班' ? 'active' : ''}}" data-category="加班" bindtap="switchCategory">加班</view>
          <view class="segment-item {{form.category === '请假' ? 'active' : ''}}" data-category="请假" bindtap="switchCategory">请假</view>
        </view>
        <view class="field-block">
          <view class="field-label">开始时间</view>
          <picker mode="time" value="{{form.startTime}}" data-field="startTime" bindchange="onTimeChange">
            <view class="field-input">{{form.startTime}}</view>
          </picker>
        </view>
        <view class="field-block">
          <view class="field-label">结束时间</view>
          <picker mode="time" value="{{form.endTime}}" data-field="endTime" bindchange="onTimeChange">
            <view class="field-input">{{form.endTime}}</view>
          </picker>
        </view>
        <view class="field-block">
          <view class="field-label">工时 / 时长</view>
          <view class="duration-row">
            <input class="field-input flex-fill" type="digit" value="{{form.duration}}" bindinput="onDurationInput" />
            <view class="duration-chip">{{fmt.fmtDur(form.duration, settingDurationFormat)}}</view>
          </view>
        </view>
        <view class="field-block">
          <view class="field-label">类型</view>
          <picker mode="selector" range="{{currentTypeOptions}}" bindchange="onTypeChange">
            <view class="field-input">{{form.type}}</view>
          </picker>
        </view>
        <view class="field-block">
          <view class="field-label">备注</view>
          <textarea class="note-area" value="{{form.note}}" maxlength="100" bindinput="onNoteInput" placeholder="填写备注，如加班原因…" />
        </view>
        <view class="field-block">
          <view class="image-head">
            <view class="field-label no-margin">图片 / 语音</view>
            <view class="image-count">{{form.images.length}}/3</view>
          </view>
          <view class="image-grid">
            <view wx:for="{{form._resolvedUrls}}" wx:key="*this" class="image-item">
              <image class="record-image" src="{{item}}" mode="aspectFill" data-index="{{index}}" bindtap="previewRecordImage" />
              <view class="image-remove" data-index="{{index}}" bindtap="removeRecordImage">x</view>
            </view>
            <view wx:if="{{form.images.length < 3}}" class="image-add" bindtap="chooseRecordImages">
              <view class="image-add-plus">+</view>
              <view class="image-add-text">添加图片</view>
            </view>
            <view wx:if="{{form.voiceId}}" class="voice-bubble" bindtap="toggleFormVoicePlay">
              <view class="voice-delete" catchtap="deleteFormVoice">x</view>
              <view class="voice-bubble-dur">{{form.voiceDuration}}"</view>
              <view class="voice-waves {{isFormVoicePlaying ? 'playing' : ''}}">
                <view class="wave-bar"></view>
                <view class="wave-bar"></view>
                <view class="wave-bar"></view>
              </view>
            </view>
            <view wx:else class="voice-add-btn {{isRecording ? 'recording' : ''}}" bindtap="toggleVoiceRecord">
              <image class="voice-add-icon-img" src="/speech2.png" mode="aspectFit" />
              <view wx:if="{{isRecording}}" class="voice-recording-text">录制中</view>
              <view wx:else class="voice-add-text">录音</view>
            </view>
          </view>
        </view>
        <view class="sheet-actions">
          <button wx:if="{{editingRecordId}}" class="btn-danger delete-btn" bindtap="deleteRecord">删除记录</button>
          <button class="btn-primary save-btn {{form.category === '请假' ? 'leave-save' : ''}}" bindtap="saveRecord">保存记录</button>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{showPayRuleSheet}}" class="payrule-mask" bindtap="closePayRuleSheet">
    <view class="payrule-sheet" catchtap="noop">
      <view class="payrule-title">计算规则</view>
      <view
        wx:for="{{payRules}}"
        wx:key="id"
        class="payrule-item {{payRule.mode === item.id ? 'active' : ''}}"
        data-id="{{item.id}}"
        bindtap="selectPayRule"
      >
        <view class="payrule-info">
          <view class="payrule-name">{{item.name}}</view>
          <view class="payrule-sub">平日 x{{item.weekday}} · 周末 x{{item.weekend}} · 节假日 x{{item.holiday}} · {{item.deductLeave ? '调休抵扣' : '不抵扣'}}</view>
        </view>
        <view wx:if="{{payRule.mode === item.id}}" class="payrule-check">✓</view>
      </view>
      <view class="payrule-item {{payRuleDraft && payRuleDraft.mode === 'custom' ? 'active' : ''}}" data-id="custom" bindtap="selectPayRule">
        <view class="payrule-info">
          <view class="payrule-name">自定义</view>
          <view class="payrule-sub">按下方倍数计算</view>
        </view>
        <view wx:if="{{payRule.mode === 'custom' && !payRuleDraft}}" class="payrule-check">✓</view>
      </view>
      <view class="payrule-item {{payRuleDraft && payRuleDraft.mode === 'tier' ? 'active' : ''}}" data-id="tier" bindtap="selectPayRule">
        <view class="payrule-info">
          <view class="payrule-name">阶梯规则</view>
          <view class="payrule-sub">按累计加班时长分档计费</view>
        </view>
        <view wx:if="{{payRule.mode === 'tier' && !payRuleDraft}}" class="payrule-check">✓</view>
      </view>
      <block wx:if="{{payRuleDraft && payRuleDraft.mode === 'tier'}}">
        <view class="payrule-edit">
          <view class="payrule-sub" style="margin-bottom: 20rpx;">达到开始时长后按档位发固定加班费：前置档金额自定义，之后每档 = 上一档 + 递增金额</view>
          <view class="payrule-edit-row">
            <view class="f-label">开始时长（小时）</view>
            <input class="payrule-input" type="digit" value="{{payRuleDraft.startHours}}" data-field="startHours" bindinput="onPayRuleField" />
          </view>
          <view class="front-head">前置档（可选，最多 3 个）</view>
          <view wx:for="{{payRuleDraft.frontBrackets}}" wx:key="index" class="front-row">
            <text class="front-label">间隔</text>
            <input class="payrule-input front-input" type="digit" value="{{item.hours}}" data-index="{{index}}" data-field="hours" bindinput="onFrontField" />
            <text class="front-label">小时</text>
            <text class="front-label">金额</text>
            <input class="payrule-input front-input" type="digit" value="{{item.amount}}" data-index="{{index}}" data-field="amount" bindinput="onFrontField" />
            <text class="front-label">元</text>
            <view class="front-del" data-index="{{index}}" bindtap="removeFrontBracket">✕</view>
          </view>
          <view wx:if="{{payRuleDraft.frontBrackets.length < 3}}" class="front-add" bindtap="addFrontBracket">+ 添加前置档</view>
          <view class="payrule-edit-row">
            <view class="f-label">每档间隔（小时）</view>
            <input class="payrule-input" type="digit" value="{{payRuleDraft.intervalHours}}" data-field="intervalHours" bindinput="onPayRuleField" />
          </view>
          <view class="payrule-edit-row">
            <view class="f-label">每档递增（元）</view>
            <input class="payrule-input" type="digit" value="{{payRuleDraft.stepIncrement}}" data-field="stepIncrement" bindinput="onPayRuleField" />
          </view>
          <view class="payrule-edit-row">
            <view class="f-label">首档金额（元）</view>
            <input class="payrule-input" type="digit" value="{{payRuleDraft.baseAmount}}" data-field="baseAmount" bindinput="onPayRuleField" />
          </view>
          <view class="payrule-sub" style="margin-bottom: 20rpx;">「首档金额」在未添加前置档时生效</view>
          <view class="payrule-edit-row">
            <view class="f-label">最大时长（小时）</view>
            <input class="payrule-input" type="digit" value="{{payRuleDraft.maxHours}}" data-field="maxHours" bindinput="onPayRuleField" />
          </view>
          <view class="payrule-edit-row">
            <view class="f-label">请假抵扣加班</view>
            <switch checked="{{payRuleDraft.deductLeave}}" color="#4f7af5" bindchange="onPayRuleDeduct" />
          </view>
          <button class="btn-primary payrule-confirm" bindtap="confirmPayRule">使用阶梯规则</button>
        </view>
      </block>
      <block wx:if="{{payRuleDraft && payRuleDraft.mode === 'custom'}}">
        <view class="payrule-edit">
          <view class="payrule-edit-row">
            <view class="f-label">平日倍数</view>
            <input class="payrule-input" type="digit" value="{{payRuleDraft.weekday}}" data-field="weekday" bindinput="onPayRuleField" />
          </view>
          <view class="payrule-edit-row">
            <view class="f-label">周末倍数</view>
            <input class="payrule-input" type="digit" value="{{payRuleDraft.weekend}}" data-field="weekend" bindinput="onPayRuleField" />
          </view>
          <view class="payrule-edit-row">
            <view class="f-label">节假日倍数</view>
            <input class="payrule-input" type="digit" value="{{payRuleDraft.holiday}}" data-field="holiday" bindinput="onPayRuleField" />
          </view>
          <view class="payrule-edit-row">
            <view class="f-label">请假抵扣加班</view>
            <switch checked="{{payRuleDraft.deductLeave}}" color="#4f7af5" bindchange="onPayRuleDeduct" />
          </view>
          <button class="btn-primary payrule-confirm" bindtap="confirmPayRule">使用自定义规则</button>
        </view>
      </block>
    </view>
  </view>

  <view wx:if="{{cheer.show}}" class="cheer-card {{cheer.kind === 'achievement' ? 'achievement' : ''}}" catchtap="noop">
    <view class="cheer-emoji">{{cheer.emoji}}</view>
    <view wx:if="{{cheer.title}}" class="cheer-title">{{cheer.title}}</view>
    <view class="cheer-text">{{cheer.text}}</view>
    <view class="cheer-caption">{{cheer.caption}}</view>
  </view>

  <view wx:if="{{showAchievementDetailCard && achievementDetail}}" class="ach-detail-mask" bindtap="closeAchievementDetail">
    <view class="ach-detail-card" catchtap="noop">
      <view class="ach-detail-close" bindtap="closeAchievementDetail">x</view>
      <image wx:if="{{posterPreview}}" class="ach-detail-poster" src="{{posterPreview}}" mode="aspectFit" />
      <view wx:else class="ach-detail-generating">海报生成中…</view>
      <button class="btn-primary ach-poster-btn" bindtap="saveAchievementPosterImage">分享 / 保存</button>
    </view>
  </view>
</view>

